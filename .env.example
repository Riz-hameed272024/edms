# Copy to .env for local runs. NEVER commit .env. In Kubernetes these come from Secret edms-secrets.
NODE_ENV=development
PORT=8080
# RS256 key pair (PEM, \n-escaped). If absent in development/test an ephemeral pair is generated.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# HMAC key used to sign emergency notifications and audit records
AUDIT_HMAC_KEY=
